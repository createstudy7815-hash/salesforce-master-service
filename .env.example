# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL / SQLite fallback for local test)
DATABASE_URL=postgresql://salesforce_user:salesforce_password@localhost:5432/salesforce_master
DATABASE_POOL_SIZE=10

# Salesforce Default API Settings
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=v60.0
SF_TIMEOUT_SECONDS=60
SF_BULK_POLL_INTERVAL_SECONDS=5
SF_BULK_MAX_WAIT_MINUTES=30

# MinIO / Object Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=salesforce-data
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Resilience & Retries
EXTERNAL_CALL_MAX_RETRIES=3
EXTERNAL_CALL_RETRY_DELAYS=[2, 5, 10]
EXTERNAL_CALL_JITTER=true
DLQ_PAYLOAD_MAX_BYTES=65536

# HMAC Security (Coordinator & Engineer keys)
HMAC_ENABLED=false
HMAC_SECRET_KEY_CORE=dev_coordinator_secret_key_32bytes_min
HMAC_SECRET_KEY_ENGINEER=dev_engineer_secret_key_32bytes_min
HMAC_SIGNATURE_MAX_AGE=300
